+"""Per-turn repository snapshots (tib redo_v1 local patch).
+
+`repo_diff.capture_git_diff` already commits the workspace as `harbor-turn-<N>`
+inside the sandbox and writes `patches/turn-<N>.patch` - but only when the diff is
+non-empty, and with nothing that ties a snapshot to the conversation. The redo
+study needs, for every agent turn, the exact repository state *before* the user's
+reply is produced, so regressions can be judged turn by turn.
+
+This module writes, for every call of `capture_git_diff` (i.e. after every agent
+turn, before the simulated user is consulted):
+
+    <logs_dir>/snapshots/turn-<N>.patch        cumulative diff vs `harbor-base`
+                                               (always written, possibly empty)
+    <logs_dir>/snapshots/turn-<N>.json         digest, files, sizes, timing
+
+and the wrapper appends one line per agent turn to `<logs_dir>/turns.jsonl`
+(`record_turn`): the message that opened the turn, the snapshot written at its
+end, and (filled in on the next line's `reply`) the simulated user's reaction.
+The patch is the same artefact the judge applies (junk-filtered cumulative diff),
+so a snapshot can be materialised in a fresh sandbox exactly like `final.patch`.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import time
+from pathlib import Path
+
+SNAPSHOT_SCHEMA = "swt-turn-snapshot/1"
+
+
+def _files(diff: str) -> list[str]:
+    return sorted({m.group(1) for m in re.finditer(r"^diff --git a/(.+?) b/", diff, re.M)})
+
+
+def write_turn_snapshot(logs_dir: Path, turn: int, cumulative: str, incremental: str,
+                        *, capture_ok: bool = True, error: str | None = None) -> dict:
+    snap_dir = Path(logs_dir) / "snapshots"
+    snap_dir.mkdir(parents=True, exist_ok=True)
+    body = cumulative + "\n" if cumulative else ""
+    (snap_dir / f"turn-{turn}.patch").write_text(body)
+    meta = {
+        "schema": SNAPSHOT_SCHEMA,
+        "turn": turn,
+        "captured_at": time.time(),
+        "capture_ok": capture_ok,
+        "error": error,
+        "sandbox_ref": f"harbor-turn-{turn}",
+        "cumulative_sha256": hashlib.sha256(body.encode()).hexdigest(),
+        "cumulative_bytes": len(body),
+        "cumulative_files": _files(cumulative),
+        "incremental_sha256": hashlib.sha256(incremental.encode()).hexdigest(),
+        "incremental_bytes": len(incremental),
+        "incremental_files": _files(incremental),
+        "empty": not cumulative.strip(),
+    }
+    (snap_dir / f"turn-{turn}.json").write_text(json.dumps(meta, indent=2))
+    return meta
+
+
+def record_turn(logs_dir: Path, record: dict) -> None:
+    """Append one agent-turn record to ``<logs_dir>/turns.jsonl``."""
+    rec = {"ts": time.time(), **record}
+    with open(Path(logs_dir) / "turns.jsonl", "a") as f:
+        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
