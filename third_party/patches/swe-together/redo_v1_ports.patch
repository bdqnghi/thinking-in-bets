diff --git a/src/user_agent/redo_arms.py b/src/user_agent/redo_arms.py
new file mode 100644
index 0000000..421c214
--- /dev/null
+++ b/src/user_agent/redo_arms.py
@@ -0,0 +1,470 @@
+"""Redo-robustness arms and the pushback overlay (tib redo_v1 local patch, PLAN.md §6-§8).
+
+Selected by environment (all unset = stock, byte-identical behaviour):
+
+    SWT_REDO_ARM           stock | commit_before | claims_after | claims_no_p | recap | minimal_edit
+                           | tracker | mediator  (controlled ports of IDSS / Mediator-Assistant,
+                             ``redo_ports.py``; not native reproductions)
+    SWT_REDO_TAU           claim threshold tau (default 0.5)
+    SWT_REDO_CLAIM_REASONING  reasoning_effort of the claim-book call (default "high", = the agent's)
+    SWT_REDO_OVERLAY       "1" = pushback overlay trial (C1)
+    SWT_REDO_OVERLAY_SEED  integer seed of the overlay's template / target choice
+    SWT_REDO_TIB_ROOT      tib checkout (the overlay imports fsa.redo.intent_judge from it)
+    SWT_REDO_JUDGE_CACHE   intent-judge cache dir (default <tib>/results/redo_v1/intent_judge_cache)
+
+Arms act only on the message delivered to the agent (``opencode run --session``).
+The simulated user never sees a claim book, recap or instruction: it is consulted
+with the benchmark's own inputs, and its history holds only what it said (or, on an
+overlay turn, the overlay message it is made to have said).
+
+claim-book arms (``commit_before``, ``claims_after``, ``claims_no_p``): at every
+simulator consultation one extra call to the agent's own model (host LiteLLM, same
+model and thinking level as the agent) over the session so far writes
+``claims/turn-<N>.json`` (N = the agent turn just finished). ``commit_before`` and
+``claims_no_p`` make the call before the simulator is consulted; ``claims_after``
+makes the identical call after the reply is known, with the reply appended to the
+input (the only prompt difference). When the reply is a real message the claim book
+and the method rules are appended to it; on a silent (no-op) turn the agent gets the
+benchmark's plain "continue".
+
+port arms (``tracker``, ``mediator``; baseline-port revision, PLAN.md §8): after the simulator
+decided and only for a real reply, one call of the agent's own model (``redo_ports.PortArm``,
+byte-identical to tib's ``fsa/redo/ports.py``): the tracker updates the situation state
+(``ports/turn-<N>.json``) and the reply is delivered with it; the mediator rewrites the reply
+into an explicit first-person request, which is delivered instead of the reply. Every attempt
+in ``port_calls.jsonl`` (their own token seat). The simulator never sees either output.
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import logging
+import os
+import random
+import sys
+import time
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+log = logging.getLogger(__name__)
+
+PROMPTS = Path(__file__).with_name("prompts") / "redo"
+PORT_ARMS = ("tracker", "mediator")  # = redo_ports.PORT_ARMS (not imported: this file is also loaded by path)
+ARMS = ("stock", "commit_before", "claims_after", "claims_no_p", "recap", "minimal_edit", *PORT_ARMS)
+CLAIM_TIMING = {"commit_before": "before", "claims_no_p": "before", "claims_after": "after"}
+MAX_OVERLAYS = 2
+HARNESS_SUFFIX_MARKERS = ("\n\n## Repository Configuration Files", "## Repository Configuration Files\n",
+                          "\n\nIMPORTANT: Work incrementally.")
+
+_TRANSIENT = ("429", "rate limit", "ratelimit", "resource_exhausted", "resource has been exhausted", "quota",
+              "503", "unavailable", "overloaded", "500", "502", "504", "internal error", "internalservererror",
+              "timeout", "timed out", "connection", "high demand", "empty response", "invalid json")
+BACKOFF_SEC = (10, 20, 40, 60, 90, 120, 180, 240, 300)
+
+
+def prompt(name: str) -> str:
+    return (PROMPTS / name).read_text()
+
+
+def prompts_sha256() -> dict[str, str]:
+    return {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(PROMPTS.iterdir()) if p.is_file()}
+
+
+@dataclass
+class RedoConfig:
+    arm: str = "stock"
+    tau: float = 0.5
+    claim_reasoning: str = "high"
+    overlay: bool = False
+    overlay_seed: int = 0
+    transcript_chars: int = 160_000
+    tib_root: str | None = None
+    judge_cache: str | None = None
+
+    @classmethod
+    def from_env(cls) -> "RedoConfig":
+        arm = os.environ.get("SWT_REDO_ARM", "stock") or "stock"
+        if arm not in ARMS:
+            raise ValueError(f"SWT_REDO_ARM={arm!r} not in {ARMS}")
+        return cls(arm=arm, tau=float(os.environ.get("SWT_REDO_TAU", "0.5")),
+                   claim_reasoning=os.environ.get("SWT_REDO_CLAIM_REASONING", "high"),
+                   overlay=os.environ.get("SWT_REDO_OVERLAY", "") == "1",
+                   overlay_seed=int(os.environ.get("SWT_REDO_OVERLAY_SEED", "0")),
+                   tib_root=os.environ.get("SWT_REDO_TIB_ROOT"),
+                   judge_cache=os.environ.get("SWT_REDO_JUDGE_CACHE"))
+
+    @property
+    def active(self) -> bool:
+        return self.arm != "stock" or self.overlay
+
+    @property
+    def claim_timing(self) -> str | None:
+        return CLAIM_TIMING.get(self.arm)
+
+    @property
+    def port(self) -> str | None:
+        return self.arm if self.arm in PORT_ARMS else None
+
+
+# ── session transcript for the claim-book call ──────────────────────────────
+
+def _events(raw: str) -> list[tuple[str, str]]:
+    out = []
+    for line in (raw or "").split("\n"):
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            e = json.loads(line)
+        except (json.JSONDecodeError, ValueError):
+            continue
+        part = e.get("part") or {}
+        if e.get("type") == "text":
+            t = part.get("text")
+            if isinstance(t, str) and t.strip():
+                out.append(("text", t.strip()[:3000]))
+        elif e.get("type") == "tool_use":
+            st = part.get("state") if isinstance(part.get("state"), dict) else {}
+            args = st.get("input") or part.get("input") or {}
+            args = args if isinstance(args, str) else json.dumps(args)
+            res = st.get("output") or part.get("output") or ""
+            res = res if isinstance(res, str) else json.dumps(res)
+            name = part.get("tool") or part.get("name") or "?"
+            res = res if len(res) <= 600 else "..." + res[-600:]
+            out.append(("tool", f"{name}({args[:400]}) -> {res}"))
+    return out
+
+
+def session_transcript(logs_dir: Path, instruction: str, openers: list[dict], budget: int) -> str:
+    """Opening request + every executed turn's opener and the agent's events
+    (from the per-turn archives ``opencode.txt.turn-<N>``), newest turns kept
+    first when the budget binds."""
+    head = f"## Turn 0 - the user's opening request\n{instruction[:8000]}\n"
+    blocks = []
+    for o in openers:
+        t = o["turn"]
+        f = Path(logs_dir) / f"opencode.txt.turn-{t}"
+        ev = _events(f.read_text(errors="replace")) if f.exists() else []
+        lines = []
+        if t > 0:
+            who = {"sim": "the user", "overlay": "the user", "noop_continue": "(no user message)",
+                   "cap_rescue": "(harness: resume after interruption)"}.get(o.get("opened_by"), o.get("opened_by"))
+            lines.append(f"## Turn {t} - {who}: {o.get('message') or ''}")
+        lines.append(f"### Your work in turn {t}")
+        for kind, s in ev:
+            lines.append(("[you] " if kind == "text" else "[tool] ") + s)
+        if not ev:
+            lines.append("(no recorded events)")
+        blocks.append("\n".join(lines))
+    kept, used = [], len(head)
+    for b in reversed(blocks):
+        if used + len(b) > budget:
+            kept.append("[... earlier turns elided ...]")
+            break
+        kept.append(b)
+        used += len(b)
+    return head + "\n\n".join(reversed(kept))
+
+
+def render_book(book: dict, with_p: bool) -> str:
+    lines = []
+    for c in book.get("claims") or []:
+        p = c.get("p")
+        ptxt = f" (p={float(p):.2f})" if with_p and isinstance(p, (int, float)) else ""
+        lines.append(f"{c.get('id', '?')}{ptxt} {c.get('claim', '')} - evidence: {c.get('evidence', 'none')}")
+    rej = book.get("rejected") or []
+    lines.append("Rejected options:" + ("" if rej else " none"))
+    for r in rej:
+        lines.append(f"- {r.get('option', '')} (turn {r.get('turn', '?')}): {r.get('reason', '')}")
+    return "\n".join(lines)
+
+
+def _valid_book(d, with_p: bool) -> bool:
+    if not isinstance(d, dict) or not isinstance(d.get("claims"), list) or not d["claims"]:
+        return False
+    for c in d["claims"]:
+        if not isinstance(c, dict) or not c.get("claim"):
+            return False
+        if with_p:
+            try:
+                p = float(c.get("p"))
+            except (TypeError, ValueError):
+                return False
+            if not 0.0 <= p <= 1.0:
+                return False
+    return isinstance(d.get("rejected", []), list)
+
+
+class RedoArms:
+    """Per-trial state of one arm (+ overlay). Nothing carries across tasks: a new
+    wrapper, hence a new instance, is built for every trial."""
+
+    def __init__(self, cfg: RedoConfig, logs_dir: Path, agent_model: str):
+        self.cfg = cfg
+        self.logs_dir = Path(logs_dir)
+        # opencode names the native Gemini provider `google/`; LiteLLM calls it `gemini/`.
+        prov, _, name = (agent_model or "").partition("/")
+        self.claim_model = f"gemini/{name}" if prov == "google" else agent_model
+        self.prev_book: dict | None = None
+        self.user_messages: list[str] = []  # delivered user/overlay messages (for recap)
+        self.overlay: Overlay | None = None
+        self.port = None
+        if cfg.port:
+            from . import redo_ports  # noqa: PLC0415 - package import only when a port arm runs
+            self._ports = redo_ports
+            self.port = redo_ports.PortArm(cfg.port, self.logs_dir, agent_model, prefix="turn")
+
+    # ── port arms (tracker / mediator) ──
+
+    def _dialogue(self, instruction: str, openers: list[dict], reply: str) -> list[dict]:
+        msgs: list[dict] = []
+
+        def add(role, text):
+            text = (text or "").strip()
+            if not text:
+                return
+            if msgs and msgs[-1]["role"] == role:
+                msgs[-1]["content"] += "\n" + text
+            else:
+                msgs.append({"role": role, "content": text})
+
+        # the opening request as the user wrote it: the harness appends the repository's config
+        # files (repo_config.py) and the incremental-work notice to the agent's first message;
+        # those are not the user's words (they would fill the mediator's transcript cap)
+        opening = instruction
+        for marker in HARNESS_SUFFIX_MARKERS:
+            if marker in opening:
+                opening = opening.split(marker, 1)[0]
+        add("user", opening)
+        for o in openers:
+            t = o["turn"]
+            if t > 0 and o.get("opened_by") in ("sim", "overlay"):
+                add("user", o.get("message"))
+            f = self.logs_dir / f"opencode.txt.turn-{t}"
+            if f.exists():
+                for it in self._ports.stream_items(f.read_text(errors="replace")):
+                    if it["kind"] == "text":
+                        add("assistant", it["text"])
+        add("user", reply)
+        return msgs
+
+    async def port_update(self, *, snapshot_turn: int, loop_turn: int, instruction: str, openers: list[dict],
+                          diff_text: str, reply: str, sim_decided_ts: float, opened_by: str) -> dict:
+        """tracker / mediator call for a real reply (after the simulator decided)."""
+        meta = {"snapshot_turn": snapshot_turn, "loop_turn": loop_turn, "sim_decided_ts": sim_decided_ts,
+                "opened_by": opened_by}
+        if self.cfg.port == "tracker":
+            streams = []
+            for o in openers:
+                f = self.logs_dir / f"opencode.txt.turn-{o['turn']}"
+                if f.exists():
+                    streams.append((o["turn"], f.read_text(errors="replace")))
+            transcript = session_transcript(self.logs_dir, instruction, openers, self.cfg.transcript_chars)
+            return await asyncio.to_thread(self.port.tracker_update, index=snapshot_turn, transcript=transcript,
+                                           streams=streams, diff_text=diff_text, snapshot=f"turn-{snapshot_turn}",
+                                           reply=reply, meta=meta)
+        return await asyncio.to_thread(self.port.mediate, index=snapshot_turn,
+                                       dialogue=self._dialogue(instruction, openers, reply), meta=meta)
+
+    # ── claim book ──
+
+    async def write_claim_book(self, *, snapshot_turn: int, loop_turn: int, instruction: str,
+                               openers: list[dict], diff_text: str, reply: str | None) -> dict:
+        with_p = self.cfg.arm != "claims_no_p"
+        system = prompt("claim_book_system.md" if with_p else "claim_book_system_no_p.md")
+        diff = diff_text or ""
+        if len(diff) > 60_000:
+            diff = diff[:60_000] + "\n[... diff truncated ...]"
+        user = (session_transcript(self.logs_dir, instruction, openers, self.cfg.transcript_chars)
+                + f"\n\n## Current cumulative diff of the repository\n```diff\n{diff.strip() or '(empty)'}\n```\n"
+                + "\n## Your previous claim book\n"
+                + (json.dumps(self.prev_book, ensure_ascii=False) if self.prev_book else "(none yet)") + "\n")
+        if reply is not None:  # claims_after only: the one difference from commit_before
+            user += f"\n## The user's latest message\n{reply}\n"
+        # closing request (same in every arm): without it the model tends to continue the
+        # work and emit a tool call / empty text instead of the book (Stage 1 smoke)
+        user += "\n" + prompt("claim_book_request.md")
+        book, ok, records = None, False, []
+        import litellm
+        t_start = time.time()
+        for attempt in range(1, len(BACKOFF_SEC) + 2):
+            t0 = time.time()
+            rec = {"ts": t0, "snapshot_turn": snapshot_turn, "loop_turn": loop_turn, "attempt": attempt,
+                   "model": self.claim_model, "reasoning_effort": self.cfg.claim_reasoning,
+                   "reply_visible": reply is not None, "prompt_chars": len(system) + len(user)}
+            try:
+                r = await litellm.acompletion(
+                    model=self.claim_model,
+                    messages=[{"role": "system", "content": system}, {"role": "user", "content": user}],
+                    response_format={"type": "json_object"}, reasoning_effort=self.cfg.claim_reasoning,
+                    timeout=600, num_retries=0)
+                u = getattr(r, "usage", None)
+                ptd = getattr(u, "prompt_tokens_details", None)
+                ctd = getattr(u, "completion_tokens_details", None)
+                content = (r.choices[0].message.content or "").strip()
+                rec.update(latency_sec=round(time.time() - t0, 2), resolved_model=getattr(r, "model", None),
+                           finish_reason=getattr(r.choices[0], "finish_reason", None),
+                           prompt_tokens=getattr(u, "prompt_tokens", None),
+                           completion_tokens=getattr(u, "completion_tokens", None),
+                           reasoning_tokens=getattr(ctd, "reasoning_tokens", None),
+                           cached_tokens=getattr(ptd, "cached_tokens", None), raw=content[:20000])
+                if not content:
+                    raise ValueError("empty response")
+                d = json.loads(content.removeprefix("```json").removesuffix("```").strip())
+                if not _valid_book(d, with_p):
+                    raise ValueError("invalid json claim book (schema)")
+                book, ok = d, True
+                rec["ok"] = True
+                records.append(rec)
+                break
+            except Exception as e:  # noqa: BLE001
+                rec.update(ok=False, latency_sec=round(time.time() - t0, 2),
+                           error=f"{type(e).__name__}: {str(e)[:300]}")
+                records.append(rec)
+                txt = f"{type(e).__name__} {e}".lower()
+                transient = any(m in txt for m in _TRANSIENT) or isinstance(e, json.JSONDecodeError)
+                if not transient or attempt > len(BACKOFF_SEC) or (isinstance(e, ValueError) and attempt >= 4):
+                    break
+                await asyncio.sleep(BACKOFF_SEC[attempt - 1])
+        with open(self.logs_dir / "claim_calls.jsonl", "a") as f:
+            for r_ in records:
+                f.write(json.dumps(r_, ensure_ascii=False) + "\n")
+        doc = {"schema": "redo_v1/claim-book/1", "arm": self.cfg.arm, "tau": self.cfg.tau if with_p else None,
+               "snapshot_turn": snapshot_turn, "loop_turn": loop_turn,
+               # timing relative to the simulator's decision (claims_after on a silent turn: after, no reply)
+               "phase": "after_reply" if self.cfg.claim_timing == "after" else "before_reply",
+               "reply_visible": reply is not None, "reply": reply, "call_started_at": t_start,
+               "written_at": time.time(), "model": self.claim_model, "ok": ok, "attempts": len(records),
+               "book": book}
+        d = self.logs_dir / "claims"
+        d.mkdir(exist_ok=True)
+        (d / f"turn-{snapshot_turn}.json").write_text(json.dumps(doc, indent=2, ensure_ascii=False))
+        if ok:
+            self.prev_book = book
+        return doc
+
+    # ── delivered message ──
+
+    def compose(self, reply: str, claim_doc: dict | None, instruction: str, port_doc: dict | None = None) -> str:
+        """The message the agent receives for a real user reply (not for 'continue')."""
+        arm = self.cfg.arm
+        self.user_messages.append(reply)
+        if self.port is not None:
+            return self.port.compose(reply, port_doc)
+        if self.cfg.claim_timing:
+            if not (claim_doc and claim_doc.get("ok")):
+                return reply  # claim call failed: recorded; the reply goes through unchanged
+            with_p = arm != "claims_no_p"
+            rules = prompt("rules_p.md" if with_p else "rules_no_p.md")
+            block = rules.replace("{claim_book}", render_book(claim_doc["book"], with_p)).replace(
+                "{tau}", f"{self.cfg.tau:g}")
+            return f"{reply}\n\n{block.rstrip()}"
+        if arm == "recap":
+            reqs = [f"1. (opening request) {instruction[:1500]}"]
+            reqs += [f"{i + 2}. {m}" for i, m in enumerate(self.user_messages)]
+            return f"{reply}\n\n" + prompt("recap.md").replace("{requirements}", "\n".join(reqs)).rstrip()
+        if arm == "minimal_edit":
+            return f"{reply}\n\n" + prompt("minimal_edit.md").rstrip()
+        return reply
+
+
+# ── pushback overlay (C1) ───────────────────────────────────────────────────
+
+class Overlay:
+    """Scripted, seeded injector. At the first simulator consultation where the
+    per-intent judge (repository + intent only) says every revealed applicable
+    intent of snapshot N is satisfied, the simulator's reply is replaced by an
+    unjustified correction; at a later such consultation, by a mis-aimed
+    correction naming one satisfied intent as broken. At most two per session."""
+
+    def __init__(self, cfg: RedoConfig, logs_dir: Path, task_dir: Path):
+        self.cfg = cfg
+        self.logs_dir = Path(logs_dir)
+        self.task_dir = Path(task_dir)
+        self.rng = random.Random(f"{cfg.overlay_seed}:{self.task_dir.name}")
+        self.templates = json.loads(prompt("overlay_templates.json"))
+        self.injected: list[dict] = []
+        self._judge = None
+        self._ij = None
+
+    def _load_judge(self):
+        if self._judge is None:
+            root = self.cfg.tib_root
+            if not root:
+                raise RuntimeError("SWT_REDO_TIB_ROOT is required for the overlay (intent judge)")
+            if root not in sys.path:
+                sys.path.insert(0, root)
+            from fsa.redo import intent_judge as ij  # noqa: PLC0415
+            self._ij = ij
+            cache = self.cfg.judge_cache or str(Path(root) / "results" / "redo_v1" / "intent_judge_cache")
+            self._judge = ij.IntentJudge(cache, workers=4)
+        return self._judge, self._ij
+
+    @property
+    def done(self) -> bool:
+        return len(self.injected) >= MAX_OVERLAYS
+
+    async def evaluate(self, snapshot_turn: int, n_sim_messages: int) -> dict:
+        """Judge snapshot N on the revealed intents (synchronously w.r.t. the trial)."""
+        judge, ij = self._load_judge()
+        intents = ij.load_task_intents(self.task_dir)
+        rev = ij.revealed(intents, n_sim_messages)
+        snap = self.logs_dir / "snapshots" / f"turn-{snapshot_turn}.patch"
+        patch = snap.read_text() if snap.exists() else ""
+        before = dict(judge.stats)
+        t0 = time.time()
+        try:
+            v = await asyncio.to_thread(judge.judge_snapshot, patch, rev)
+            err = None
+        except Exception as e:  # noqa: BLE001
+            v, err = {}, f"{type(e).__name__}: {str(e)[:300]}"
+        labels = {k: x["verdict"] for k, x in v.items()}
+        applicable = [k for k, l in labels.items() if l != "not_applicable"]
+        all_sat = bool(applicable) and all(labels[k] == "satisfied" for k in applicable) and err is None
+        rec = {"snapshot_turn": snapshot_turn, "n_sim_messages": n_sim_messages,
+               "revealed": [i.key for i in rev], "labels": labels,
+               "evidence": {k: x.get("evidence") for k, x in v.items()},
+               "patch_sha256": ij.patch_sha(patch), "all_revealed_satisfied": all_sat, "error": err,
+               "started_at": t0, "finished_at": time.time(), "judge": ij.judge_config(),
+               "judge_stats_delta": {k: judge.stats[k] - before.get(k, 0) for k in judge.stats},
+               "texts": {i.key: i.text[:300] for i in rev}}
+        d = self.logs_dir / "overlay_judge"
+        d.mkdir(exist_ok=True)
+        (d / f"turn-{snapshot_turn}.json").write_text(json.dumps(rec, indent=2, ensure_ascii=False))
+        return rec
+
+    def decide(self, loop_turn: int, verdict: dict) -> dict | None:
+        if self.done or not verdict.get("all_revealed_satisfied"):
+            return None
+        if not self.injected:
+            kind = "unjustified"
+            text = self.rng.choice(self.templates["unjustified"])
+            target = None
+        else:
+            if loop_turn <= self.injected[-1]["loop_turn"]:
+                return None
+            kind = "misaimed"
+            sat = sorted(k for k, l in verdict["labels"].items() if l == "satisfied")
+            oracle = [k for k in sat if k != "open"]
+            target = self.rng.choice(oracle) if oracle else "open"
+            if target == "open":
+                text = self.rng.choice(self.templates["misaimed_open"])
+            else:
+                it = verdict["texts"].get(target, "").strip().rstrip(".")
+                it = it[:200] + ("..." if len(it) > 200 else "")
+                text = self.rng.choice(self.templates["misaimed"]).replace("{intent}", it)
+        rec = {"loop_turn": loop_turn, "snapshot_turn": verdict["snapshot_turn"], "kind": kind,
+               "message": text, "target_intent": target, "seed": self.cfg.overlay_seed,
+               "index": len(self.injected) + 1, "decided_at": time.time()}
+        self.injected.append(rec)
+        return rec
+
+
+def config_record(cfg: RedoConfig) -> dict:
+    rec = {**asdict(cfg), "prompts_sha256": prompts_sha256()}
+    ports_dir = Path(__file__).with_name("prompts") / "ports"
+    if ports_dir.exists():
+        rec["port_prompts_sha256"] = {p.name: hashlib.sha256(p.read_bytes()).hexdigest()
+                                      for p in sorted(ports_dir.iterdir()) if p.is_file()}
+    return rec
