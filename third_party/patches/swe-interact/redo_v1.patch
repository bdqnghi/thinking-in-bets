+                               "snapshot": f"snapshots/ask-{call_index}.patch",
+                               "snapshot_head": snap.get("head"), "snapshot_patch_sha256": snap.get("patch_sha256"),
+                               "last_resort": False, "history_reply": None, "delivered": message, "redo": redo})
