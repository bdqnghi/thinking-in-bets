+                                            "latency_sec": round(time.time() - t0, 3), "error": text[:500]})
+            if SIM_RETRY and transient and attempt <= len(SIM_RETRY_BACKOFF_SEC):
+                time.sleep(SIM_RETRY_BACKOFF_SEC[attempt - 1])
