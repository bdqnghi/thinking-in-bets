+            sha = (r.get("stdout") or "").strip()
+            if r.get("ok") and len(sha) == 40:
+                _redo_state.update(anchor=sha, anchor_source="wrapper_anchor_file")
+            else:
+                r = _repo_exec_raw("git rev-parse HEAD", max_chars=200, timeout=30)
+                sha = (r.get("stdout") or "").strip()
