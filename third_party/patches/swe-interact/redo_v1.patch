+def _repo_exec_raw(command: str, max_chars: int = SNAPSHOT_MAX_CHARS, timeout: int = 120) -> dict[str, Any]:
+    """repo_exec_server run_command without the simulator's tool-call logging."""
+    payload = json.dumps({"tool": "run_command",
