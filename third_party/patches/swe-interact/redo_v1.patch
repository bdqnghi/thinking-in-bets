+def _redo_write(rel: str, text: str, append: bool = False) -> None:
+    if REDO_DIR is None:
+        return
+    try:
+        old = os.umask(0)
+        try:
+            path = REDO_DIR / rel
+            path.parent.mkdir(parents=True, exist_ok=True)
