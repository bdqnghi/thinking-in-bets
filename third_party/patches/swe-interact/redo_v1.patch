+    except Exception as exc:
+        rec["error"] = f"{type(exc).__name__}: {exc}"
+    rec["snapshot_sec"] = round(time.time() - t0, 3)
+    _redo_write(f"snapshots/{tag}.json", json.dumps(rec, indent=2, sort_keys=True, default=str))
+    return rec
+
